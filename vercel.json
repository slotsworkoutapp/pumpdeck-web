{
  "rewrites": [
    { "source": "/u/:username", "destination": "/u" },
    { "source": "/e/:owner/:id", "destination": "/e" }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    }
  ]
}
