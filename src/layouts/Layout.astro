---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'PumpDeck — Exercises from your feed to your program',
  description = 'Build a personal program from the exercises you love — and the ones you’ve been wanting to try.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/app-icon.png" />
    <link rel="apple-touch-icon" href="/app-icon.png" />
    <meta name="theme-color" content="#f97316" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site)} />
  </head>
  <body class="bg-white text-ink font-sans antialiased">
    <header class="sticky top-0 z-50 bg-white/80 backdrop-blur">
      <div
        class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3.5"
      >
        <a href="/" class="flex items-center gap-2 font-bold tracking-tight">
          <img
            src="/app-icon.png"
            alt="PumpDeck"
            width="32"
            height="32"
            class="size-8 rounded-lg shadow-sm ring-1 ring-black/5"
          />
          <span class="text-lg">PumpDeck</span>
        </a>

        <nav
          class="hidden items-center gap-7 text-sm font-semibold text-ink-soft sm:flex"
        >
          <a class="transition hover:text-ink" href="#setup">Setup</a>
          <a class="transition hover:text-ink" href="#features">Features</a>
          <a class="transition hover:text-ink" href="#comparison">Comparison</a>
        </nav>

        <div class="flex items-center gap-2">
          <a
            href="#download"
            class="shrink-0 rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:opacity-90"
          >
            Try for free
          </a>
          <button
            id="menu-btn"
            type="button"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
            class="grid size-9 place-items-center rounded-lg text-ink sm:hidden"
          >
            <svg
              viewBox="0 0 24 24"
              class="size-6"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile dropdown — toggled by #menu-btn -->
      <div id="mobile-menu" class="hidden border-t border-slate-100 bg-white sm:hidden">
        <nav
          class="mx-auto flex max-w-6xl flex-col px-5 py-2 text-base font-semibold text-ink-soft"
        >
          <a class="py-2.5 transition hover:text-ink" href="#setup">Setup</a>
          <a class="py-2.5 transition hover:text-ink" href="#features">Features</a>
          <a class="py-2.5 transition hover:text-ink" href="#comparison">Comparison</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-slate-100 bg-slate-50">
      <div
        class="mx-auto flex max-w-6xl flex-col gap-6 px-5 py-10 text-sm text-ink-soft sm:flex-row sm:items-center sm:justify-between"
      >
        <div class="flex items-center gap-2 font-semibold text-ink">
          <img
            src="/app-icon.png"
            alt=""
            width="24"
            height="24"
            class="size-6 rounded-md ring-1 ring-black/5"
          />
          PumpDeck
        </div>
        <nav class="flex flex-wrap gap-x-6 gap-y-2">
          <a class="transition hover:text-ink" href="mailto:support@pumpdeck.app">Contact</a>
          <a class="transition hover:text-ink" href="/privacy">Privacy</a>
          <a class="transition hover:text-ink" href="/terms">Terms</a>
        </nav>
        <p>&copy; {year} PumpDeck. All rights reserved.</p>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('menu-btn');
      const menu = document.getElementById('mobile-menu');
      if (btn && menu) {
        const setOpen = (open: boolean) => {
          menu.classList.toggle('hidden', !open);
          btn.setAttribute('aria-expanded', String(open));
        };
        btn.addEventListener('click', () =>
          setOpen(menu.classList.contains('hidden'))
        );
        menu
          .querySelectorAll('a')
          .forEach((a) => a.addEventListener('click', () => setOpen(false)));
      }
    </script>
  </body>
</html>
