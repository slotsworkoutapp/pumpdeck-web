---
import '../styles/global.css';
import { appStoreUrl, socials, supportEmail } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Slots — Exercises from your feed to your program',
  description = 'Build a personal program from the exercises you love — and the ones you’ve been wanting to try.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/app-icon.png" />
    <link rel="apple-touch-icon" href="/app-icon.png" />
    <meta name="theme-color" content="#ffffff" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site)} />
  </head>
  <body class="bg-white text-ink font-sans antialiased">
    <header class="sticky top-0 z-50 bg-white/80 backdrop-blur">
      <div
        class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3.5"
      >
        <a href="/" class="flex items-center gap-2.5 font-bold tracking-tight">
          <img
            src="/app-icon.png"
            alt="Slots"
            width="44"
            height="44"
            class="size-11 rounded-xl shadow-sm ring-1 ring-black/5"
          />
          <span class="wordmark text-3xl uppercase tracking-tight">Slots</span>
        </a>

        <!-- Desktop nav -->
        <div class="hidden shrink-0 items-center gap-6 sm:flex">
          <a
            href="/use-cases"
            class="text-sm font-semibold text-ink-soft transition hover:text-ink"
          >
            Use cases
          </a>
          <a
            href="/#download"
            class="rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:opacity-90"
          >
            {appStoreUrl ? 'Try for free' : 'Coming soon'}
          </a>
        </div>

        <!-- Mobile nav. A <details> rather than a scripted panel, so it still
             opens with no JavaScript; the script below only handles closing. -->
        <details class="nav-menu relative shrink-0 sm:hidden">
          <summary
            class="grid size-11 cursor-pointer place-items-center rounded-full text-ink ring-1 ring-slate-200 transition hover:bg-slate-50"
            aria-label="Menu"
          >
            <svg class="nav-open size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
            </svg>
            <svg class="nav-close size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
            </svg>
          </summary>

          <div class="absolute right-0 top-full z-50 mt-2 w-56 rounded-2xl bg-white p-2 shadow-xl ring-1 ring-slate-200">
            <a
              href="/use-cases"
              class="block rounded-xl px-4 py-3 text-sm font-semibold text-ink transition hover:bg-slate-50"
            >
              Use cases
            </a>
            <a
              href="/#download"
              class="mt-1 block rounded-xl bg-ink px-4 py-3 text-center text-sm font-semibold text-white transition hover:opacity-90"
            >
              {appStoreUrl ? 'Try for free' : 'Coming soon'}
            </a>
          </div>
        </details>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-slate-100 bg-slate-50">
      <div
        class="mx-auto flex max-w-6xl flex-col gap-6 px-5 py-10 text-sm text-ink-soft sm:flex-row sm:items-center sm:justify-between"
      >
        <div class="wordmark flex items-center gap-2 font-semibold uppercase tracking-tight text-ink">
          <img
            src="/app-icon.png"
            alt=""
            width="24"
            height="24"
            class="size-6 rounded-md ring-1 ring-black/5"
          />
          Slots
        </div>
        <nav class="flex flex-wrap gap-x-6 gap-y-2">
          <a class="transition hover:text-ink" href="/use-cases">Use cases</a>
          <a class="transition hover:text-ink" href={`mailto:${supportEmail}`}>Contact</a>
          <a class="transition hover:text-ink" href="/privacy">Privacy</a>
          <a class="transition hover:text-ink" href="/terms">Terms</a>
          {
            socials.map((s) => (
              <a
                class="transition hover:text-ink"
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {s.name}
              </a>
            ))
          }
        </nav>
        <p>&copy; {year} Slots. All rights reserved.</p>
      </div>
    </footer>
    <style>
      /* Kill the default disclosure triangle and swap the icon when open. */
      .nav-menu > summary {
        list-style: none;
      }
      .nav-menu > summary::-webkit-details-marker {
        display: none;
      }
      .nav-menu[open] .nav-open,
      .nav-menu:not([open]) .nav-close {
        display: none;
      }
    </style>

    <script>
      // Close the mobile menu on any of the usual exits. Opening needs no JS —
      // that is what <details> is for.
      const nav = document.querySelector<HTMLDetailsElement>('.nav-menu');
      if (nav) {
        const close = () => nav.removeAttribute('open');
        nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
        document.addEventListener('click', (e) => {
          if (nav.open && !nav.contains(e.target as Node)) close();
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') close();
        });
      }
    </script>
  </body>
</html>
