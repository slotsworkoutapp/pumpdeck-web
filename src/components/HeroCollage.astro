---
// Web mirror of the app's LandingCollage (SignInGateView.swift) — staggered
// columns drifting past, bleeding off both edges and the top. Same numbers the
// app uses, so the site and the Get Started screen feel like one product:
// 4 columns x 6 tiles, 8px gaps, per-column tile proportions and start offsets
// that put neighbouring columns deliberately out of step, and alternating drift
// directions at slightly different speeds.
//
// The tiles are SCREENSHOTS OF EXERCISES FROM SOCIAL — the posts someone
// actually saves — not app chrome. Whatever is in public/hero is used; see the
// README in there. With nothing in it, tinted tiles stand in, so the
// composition is judgeable before any images exist (the app does the same).
//
// Each column is drawn TWICE and animated by exactly half the track, so the
// loop has no seam. The trailing pad matters: without it, half the track is
// six tiles plus five-and-a-half gaps and the loop visibly jumps.
import fs from 'node:fs';
import path from 'node:path';

const COLUMNS = 4;
const TILES_PER_COLUMN = 6;

// Straight from the app.
const aspects = [1.38, 1.62, 1.3, 1.5];
const starts = [-26, -104, -58, -140];
const tints = [0.16, 0.1, 0.13, 0.08];
const durations = [70, 81, 92, 103];

let photos: string[] = [];
try {
  photos = fs
    .readdirSync(path.join(process.cwd(), 'public', 'hero'))
    .filter((f) => /\.(webp|jpe?g|png|avif)$/i.test(f))
    .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }))
    .map((f) => `/hero/${f}`);
} catch {
  // No folder yet — the tinted fallback below covers it.
}

// Dealt round-robin from a rotated start, exactly like the app's sources(for:),
// so no two columns open on the same image when there are fewer than tiles.
const columnItems = Array.from({ length: COLUMNS }, (_, col) =>
  Array.from({ length: TILES_PER_COLUMN }, (_, row) => {
    const i = col + row * COLUMNS;
    return {
      src: photos.length ? photos[i % photos.length] : null,
      seed: col + row,
    };
  })
);
---

<div class="hc" aria-hidden="true">
  <div class="hc-bleed">
    {
      columnItems.map((items, col) => (
        <div
          class="hc-col"
          style={`--start:${starts[col]}px; --aspect:${aspects[col]}; --dur:${durations[col]}s;`}
        >
          <div class={`hc-track ${col % 2 === 0 ? 'hc-up' : 'hc-down'}`}>
            {/* drawn twice — the second run is what the first loops into */}
            {[...items, ...items].map((tile, i) => (
              <div class="hc-tile" style={`--tint:${tints[(tile.seed + i) % tints.length]}`}>
                {tile.src && (
                  <img src={tile.src} alt="" loading="eager" decoding="async" class="hc-img" />
                )}
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
  <div class="hc-scrim"></div>
</div>

<style>
  .hc {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  /* Wider than the section so the outer columns run off both edges — a collage
     that stops neatly inside the margins reads as a component, not a backdrop. */
  .hc-bleed {
    position: absolute;
    top: 0;
    bottom: 0;
    left: -8%;
    width: 116%;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    /* End every column on the same line.
       The columns have different tile heights and different start offsets — on
       purpose, it is what makes this a collage — but that also means their tile
       EDGES land at different heights. Fading the wash out over them left a
       ragged bottom where one column still showed a photo and its neighbour had
       already hit a gap. Masking the whole grid makes them all disappear
       together, whatever the tile boundaries are doing. */
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 48%, transparent 72%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 48%, transparent 72%);
  }
  .hc-col {
    transform: translateY(var(--start));
    overflow: hidden;
  }
  .hc-track {
    display: flex;
    flex-direction: column;
    gap: 8px;
    /* Completes the last gap so half the track is exactly one run. */
    padding-bottom: 8px;
    will-change: transform;
  }
  .hc-up {
    animation: hc-scroll-up var(--dur) linear infinite;
  }
  .hc-down {
    animation: hc-scroll-down var(--dur) linear infinite;
  }
  @keyframes hc-scroll-up {
    from { transform: translateY(0); }
    to { transform: translateY(-50%); }
  }
  @keyframes hc-scroll-down {
    from { transform: translateY(-50%); }
    to { transform: translateY(0); }
  }

  .hc-tile {
    position: relative;
    flex: none;
    aspect-ratio: 1 / var(--aspect);
    border-radius: 14px;
    overflow: hidden;
    /* Shows through before any images exist, and behind one while it loads. */
    background: rgb(37 99 235 / var(--tint));
  }
  .hc-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.88;
  }

  /* Same treatment as the app's Get Started screen: blur the photos, wash them
     white, and lay a little accent over the top. Sharp photographs behind a
     5rem headline is a fight the type loses, and the collage only has to say
     "lifters, exercises, phones" from across a room.

     backdrop-filter rather than filter on the collage itself: filter would make
     the animating columns its own containing block and blur them per frame,
     while a backdrop blur is one composited pass over whatever is behind. */
  .hc-scrim {
    position: absolute;
    inset: 0;
    -webkit-backdrop-filter: blur(5px);
    backdrop-filter: blur(5px);
    background:
      /* Near-solid ground under the copy, which sits centred. */
      radial-gradient(
        74% 60% at 50% 46%,
        rgb(255 255 255 / 1) 0%,
        rgb(255 255 255 / 1) 38%,
        rgb(255 255 255 / 0.7) 64%,
        rgb(255 255 255 / 0) 100%
      ),
      /* Lifts the whole field, and lands on solid white so the section below
         starts on the same colour it ends on. */
      linear-gradient(
        to bottom,
        rgb(255 255 255 / 0.42) 0%,
        rgb(255 255 255 / 0.55) 52%,
        rgb(255 255 255 / 1) 100%
      ),
      /* The cool cast the app landing has, so the two match. */
      linear-gradient(rgb(37 99 235 / 0.08), rgb(37 99 235 / 0.08));
  }

  /* Phones get three taller columns instead of four.
     At four, a ~390px screen showed about twenty tiles at once — a texture of
     thumbnails rather than photographs you can read. Three at ~145px wide with
     taller tiles puts around nine in view, which is what the app's Get Started
     screen shows. Desktop is unchanged; four works there because the viewport
     is wide enough for the tiles to be large already.

     The fourth column is hidden rather than not rendered — the markup is built
     at build time and cannot know the viewport. And aspect-ratio is overridden
     directly rather than through --aspect, because that var is set inline per
     column and inline styles win over the stylesheet. */
  @media (max-width: 640px) {
    .hc-bleed {
      grid-template-columns: repeat(3, 1fr);
    }
    .hc-col:nth-child(4) {
      display: none;
    }
    .hc-tile {
      aspect-ratio: 1 / 1.8;
    }
    .hc-col:nth-child(2) .hc-tile {
      aspect-ratio: 1 / 2.05;
    }
    .hc-col:nth-child(3) .hc-tile {
      aspect-ratio: 1 / 1.9;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hc-up,
    .hc-down {
      animation: none;
    }
  }
</style>
