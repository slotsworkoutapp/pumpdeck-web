---
// The same Monday, both ways, at the same time — the usual way on one side and
// Slots on the other. Only the Slots card moves: it taps a muscle, opens its
// options and picks one. That asymmetry IS the argument, so the two cards sit
// together rather than as a slider plus a near-identical card below it.
//
// Side by side on desktop, stacked with a VS between them on phones.
import SlotThumb from './SlotThumb.astro';
import { personas, DEFAULT_PERSONA } from '../lib/personas';

// The three muscles, with what you've added under each.
const logSlots = [
  {
    name: 'Upper Chest', map: 'chest', count: 8, pickIndex: 0,
    collage: [
      '/lifts/incline-dumbbell-press.webp',
      '/lifts/incline-cable-fly.webp',
      '/lifts/incline-barbell-press.webp',
      '/lifts/dips.webp',
    ],
    options: [
      { name: 'Incline DB Press', photo: '/lifts/incline-dumbbell-press.webp' },
      { name: 'Incline Cable Fly', photo: '/lifts/incline-cable-fly.webp' },
      { name: 'Incline Barbell Press', photo: '/lifts/incline-barbell-press.webp' },
    ],
  },
  {
    name: 'Front Delt', map: 'shoulders', count: 6, pickIndex: 1,
    collage: [
      '/lifts/barbell-overhead-press.webp',
      '/lifts/seated-dumbbell-press.webp',
      '/lifts/machine-shoulder-press.webp',
    ],
    options: [
      { name: 'Barbell OHP', photo: '/lifts/barbell-overhead-press.webp' },
      { name: 'Seated DB Press', photo: '/lifts/seated-dumbbell-press.webp' },
      { name: 'Machine Press', photo: '/lifts/machine-shoulder-press.webp' },
    ],
  },
  {
    name: 'Triceps', map: 'triceps', count: 12, pickIndex: 0,
    collage: [
      '/lifts/rope-pushdown.webp',
      '/lifts/skull-crusher.webp',
      '/lifts/overhead-cable-extension.webp',
    ],
    options: [
      { name: 'Rope Pushdown', photo: '/lifts/rope-pushdown.webp' },
      { name: 'Skull Crushers', photo: '/lifts/skull-crusher.webp' },
      { name: 'Overhead Ext.', photo: '/lifts/overhead-cable-extension.webp' },
    ],
  },
];
---

<section id="compare" class="bg-slate-50">
  <div class="mx-auto max-w-6xl px-5 py-24 lg:py-32">
    <div class="mx-auto max-w-3xl lg:text-center">
      <h2 class="text-4xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
        Traditional training <span
          class="align-[0.12em] text-[0.55em] font-bold tracking-wide text-slate-400"
          >VS</span
        > <span class="text-brand-600">Slots</span>
      </h2>
      <p class="mt-4 text-base text-ink-soft sm:text-lg">
        Every other way of training runs on exact exercises. In Slots, each
        line of the day is a <strong>slot</strong> — it holds a muscle, and you
        pick the exercise when you get there.
      </p>
    </div>

    <div class="mx-auto mt-14 grid max-w-4xl items-start gap-5 md:grid-cols-[1fr_auto_1fr] md:gap-6">
      <!-- The usual way -->
      <div>
        <p class="mb-3 text-center text-[11px] font-bold uppercase tracking-wide text-slate-400">
          {personas.map((p) => (
            <span data-when={p.id} hidden={p.id !== DEFAULT_PERSONA}>{p.compareBadge}</span>
          ))}
        </p>
        <div class="rounded-2xl bg-white p-5 shadow-lg ring-1 ring-slate-100">
          {
            personas.map((persona) => (
              <div data-when={persona.id} hidden={persona.id !== DEFAULT_PERSONA}>
                <p class="font-bold">Monday · Push</p>
                {persona.compareSubtitle && (
                  <p class="mt-0.5 text-xs text-slate-400">{persona.compareSubtitle}</p>
                )}
                <div class="mt-3 space-y-2.5">
                  {persona.compareRows.map((r) => (
                    <div class="flex items-center gap-3 rounded-xl bg-slate-50 px-3 py-2.5 ring-1 ring-slate-100">
                      <SlotThumb map={r.map} mode={r.map ? 'exercise' : 'unknown'} badge={false} photo={r.photo} />
                      <div class="min-w-0 flex-1">
                        <p class="truncate text-sm font-semibold">{r.name}</p>
                        {r.sub && (
                          <p class="truncate text-xs font-medium text-slate-400">{r.sub}</p>
                        )}
                      </div>
                      <span class="shrink-0 rounded-md bg-white px-2 py-1 text-xs font-bold text-slate-500 ring-1 ring-slate-200">3 × 10</span>
                    </div>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Divider: a row between the stacked cards on phones, a column between
           them on desktop. -->
      <div class="justify-self-center self-center py-1 md:py-0">
        <span class="grid size-10 place-items-center rounded-full bg-white text-xs font-bold tracking-wide text-slate-400 shadow-sm ring-1 ring-slate-200">
          VS
        </span>
      </div>

      <!-- Slots — the side that actually does something -->
      <div>
        <p class="mb-3 flex items-center justify-center gap-1.5 text-[11px] font-bold uppercase tracking-wide text-brand-600">
          <img
            src="/app-icon.png"
            alt=""
            width="16"
            height="16"
            class="size-4 rounded-[0.3rem] ring-1 ring-black/5"
          />
          Slots
        </p>
        <div class="lx-demo rounded-2xl bg-white p-5 shadow-lg ring-1 ring-brand-100">
          <p class="font-bold">Monday · Push</p>
          <p class="mt-0.5 text-xs text-slate-400">Tap a muscle — pick today's exercise</p>

          <div class="mt-3 space-y-2.5">
            {
              logSlots.map((s) => (
                <div class="lx-slot overflow-hidden rounded-xl bg-brand-50 ring-1 ring-transparent">
                  <div class="flex items-center gap-3 px-3 py-2.5">
                    <div class="relative size-12 shrink-0">
                      <div class="lx-thumb-def absolute inset-0">
                        <SlotThumb map={s.map} photos={s.collage} />
                      </div>
                      <div class="lx-thumb-pick absolute inset-0">
                        <SlotThumb map={s.map} mode="exercise" photo={s.options[s.pickIndex].photo} />
                      </div>
                    </div>
                    <div class="min-w-0 flex-1">
                      <!-- top line: muscle name → picked exercise -->
                      <div class="relative">
                        <p class="lx-name truncate text-sm font-semibold">{s.name}</p>
                        <p class="lx-pickname absolute inset-0 flex items-center gap-1 text-sm font-semibold text-ink">
                          <svg viewBox="0 0 24 24" class="size-3.5 shrink-0 text-emerald-500" fill="none" stroke="currentColor" stroke-width="3"><path d="m5 13 4 4L19 7" stroke-linecap="round" stroke-linejoin="round" /></svg>
                          <span class="truncate">{s.options[s.pickIndex].name}</span>
                        </p>
                      </div>
                      <!-- sub line: the slot kind → the muscle it belongs to -->
                      <div class="relative">
                        <p class="lx-kind truncate text-xs font-medium">
                          <span class="text-brand-600">Muscle</span>
                          <span class="text-slate-400"> · {s.count} exercises</span>
                        </p>
                        <p class="lx-anchor absolute inset-0 truncate text-xs font-medium text-slate-400">{s.name} · Muscle</p>
                      </div>
                    </div>
                    <span class="shrink-0 rounded-md bg-white px-2 py-1 text-xs font-bold text-slate-500 ring-1 ring-slate-200">3 × 10</span>
                  </div>
                  <div class="lx-opts space-y-1 px-3">
                    {
                      s.options.map((o, i) => (
                        <div class={`lx-opt flex items-center gap-2 rounded-lg bg-white px-2 py-1.5 ring-1 ring-slate-100 ${i === s.pickIndex ? 'lx-pickopt' : ''}`}>
                          <img
                            src={o.photo}
                            alt=""
                            loading="lazy"
                            decoding="async"
                            class="size-6 shrink-0 rounded-md object-cover ring-1 ring-slate-200"
                          />
                          <span class="flex-1 text-xs font-semibold">{o.name}</span>
                          <svg class="lx-check size-3.5 shrink-0 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m5 13 4 4L19 7" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        </div>
                      ))
                    }
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Tap a slot (highlight), its exercise options expand, one is selected, then
     it collapses and the pick replaces the muscle label. */
  .lx-slot {
    transition: box-shadow 0.3s ease, background-color 0.3s ease;
  }
  .lx-slot.is-open {
    box-shadow: inset 0 0 0 2px #3b82f6;
  }
  .lx-slot.is-picked {
    box-shadow: inset 0 0 0 1px #e2e8f0;
  }
  /* On pick: the exercise name takes the top line, the muscle it belongs to
     drops to the smaller sub line — both cross-fade. */
  .lx-name,
  .lx-pickname,
  .lx-kind,
  .lx-anchor {
    transition: opacity 0.3s ease;
  }
  .lx-pickname,
  .lx-anchor { opacity: 0; }
  .lx-slot.is-picked .lx-name { opacity: 0; }
  .lx-slot.is-picked .lx-pickname { opacity: 1; }
  .lx-slot.is-picked .lx-kind { opacity: 0; }
  .lx-slot.is-picked .lx-anchor { opacity: 1; }
  /* Thumbnail swaps from the muscle map to the picked exercise's image. */
  .lx-thumb-def,
  .lx-thumb-pick { transition: opacity 0.3s ease; }
  .lx-thumb-pick { opacity: 0; }
  .lx-slot.is-picked .lx-thumb-def { opacity: 0; }
  .lx-slot.is-picked .lx-thumb-pick { opacity: 1; }
  /* The options list expands only while the slot is open. */
  .lx-opts {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    padding-bottom: 0;
    transition: max-height 0.4s ease, opacity 0.35s ease, padding 0.4s ease;
  }
  .lx-slot.is-open .lx-opts {
    max-height: 140px;
    opacity: 1;
    padding-bottom: 0.625rem;
  }
  /* The chosen option checks off green. */
  .lx-check { opacity: 0; transition: opacity 0.2s ease; }
  .lx-opt.is-chosen { background: #ecfdf5; }
  .lx-opt.is-chosen .lx-check { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .lx-slot,
    .lx-name,
    .lx-pickname,
    .lx-kind,
    .lx-anchor,
    .lx-opts,
    .lx-check,
    .lx-thumb-def,
    .lx-thumb-pick {
      transition: none;
    }
  }
</style>

<script>
  const lxDemo = document.querySelector<HTMLElement>('.lx-demo');

  if (lxDemo) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const lxSlots = [...lxDemo.querySelectorAll<HTMLElement>('.lx-slot')];

    const resetLog = () =>
      lxSlots.forEach((s) => {
        s.classList.remove('is-open', 'is-picked');
        s.querySelectorAll<HTMLElement>('.lx-opt').forEach((o) => o.classList.remove('is-chosen'));
      });

    // Lock the card to its tallest state so opening a slot doesn't shove the
    // page around, or make one card jump against the other side by side.
    //
    // Measured WITHOUT opening anything: a closed .lx-opts is max-height 0 with
    // overflow hidden, so its scrollHeight still reports the real content
    // height. The previous version opened a slot and measured the whole card,
    // which meant the number depended on whatever state the animation happened
    // to be in — and could lock in a height far taller than the card ever needs.
    const OPTS_CAP = 140; // matches .lx-slot.is-open .lx-opts max-height
    const lockHeight = () => {
      lxDemo.style.minHeight = '';
      resetLog();
      const collapsed = lxDemo.getBoundingClientRect().height;
      if (!collapsed) return; // not laid out yet — leave it alone
      const tallestOpts = lxSlots.reduce((max, s) => {
        const opts = s.querySelector<HTMLElement>('.lx-opts');
        return Math.max(max, opts ? opts.scrollHeight : 0);
      }, 0);
      const expansion = Math.min(tallestOpts, OPTS_CAP) + 10; // + padding-bottom
      lxDemo.style.minHeight = `${Math.ceil(collapsed + expansion)}px`;
    };

    // After load, so webfonts have settled and the rows are their final height.
    if (document.readyState === 'complete') lockHeight();
    else window.addEventListener('load', lockHeight, { once: true });

    let resizeTimer: number;
    let lastWidth = window.innerWidth;
    window.addEventListener('resize', () => {
      // Mobile fires resize when the address bar hides; only width matters here.
      if (window.innerWidth === lastWidth) return;
      lastWidth = window.innerWidth;
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(lockHeight, 200);
    });

    if (reduce) {
      // Static: each slot shows its pick already made.
      lxSlots.forEach((s) => {
        s.classList.add('is-picked');
        s.querySelector<HTMLElement>('.lx-pickopt')?.classList.add('is-chosen');
      });
    } else {
      // Play only while on screen, and always from the top.
      let run: { cancelled: boolean } | null = null;
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              if (run) continue;
              const token = { cancelled: false };
              run = token;
              (async () => {
                while (!token.cancelled) {
                  resetLog();
                  await sleep(900); if (token.cancelled) return;
                  for (const s of lxSlots) {
                    s.classList.add('is-open');
                    await sleep(1300); if (token.cancelled) return;
                    s.querySelector<HTMLElement>('.lx-pickopt')?.classList.add('is-chosen');
                    await sleep(1300); if (token.cancelled) return;
                    s.classList.add('is-picked');
                    s.classList.remove('is-open');
                    await sleep(950); if (token.cancelled) return;
                  }
                  await sleep(3200);
                }
              })();
            } else if (run) {
              run.cancelled = true;
              run = null;
              resetLog();
            }
          }
        },
        { threshold: 0.2 }
      );
      io.observe(lxDemo);
    }
  }
</script>
