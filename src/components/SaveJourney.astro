---
import fs from 'node:fs';
import path from 'node:path';
import { personas, DEFAULT_PERSONA } from '../lib/personas';

// The save-to-set gauntlet. The hero promises "finally do the exercises you
// save" — this is the section that earns it.
//
// The whole point is the COUNT: four steps today, two with Slots. So the
// numbering has to be honest. Steps one to three are illustrated and identical
// for everyone; step four forks, because a program has no room for the exercise
// while making it up has nothing to hold it — which is why it sits outside the
// image grid rather than pretending to be a fourth picture.
const steps = [
  {
    art: '/journey/save.webp',
    step: 'You save it.',
    detail: 'A post in a folder. Saving felt like a plan.',
  },
  {
    art: '/journey/remember.webp',
    step: 'You have to remember you saved it.',
    detail: 'Days later, standing in the gym, it’s gone from your head.',
  },
  {
    art: '/journey/find.webp',
    step: 'You have to go find it.',
    detail: 'Mid-workout, scrolling your saved folder hoping you spot it.',
  },
];

// Two steps, and the first one is the whole trick: adding it IS filing it.
// Splitting "tap Add" from "it lands under the muscle" invented a second step
// the user never performs.
//
// Drop renders at these paths and they appear automatically — the row falls
// back to the check-badge layout until both exist, so it is never half
// pictures and half not.
const withSlots = [
  {
    art: '/journey/slots-add.webp',
    step: 'Tap Add. That’s it.',
    detail:
      'It is in your program before you put your phone down — video, muscle and equipment already on it. Nothing to name, tag, or fit in anywhere.',
  },
  {
    art: '/journey/slots-pick.webp',
    step: 'Pick it at the gym.',
    detail:
      'Next time that muscle comes up, tap the slot and it is right there in the list. This week, and in six months.',
  },
];

const hasArt = (p: string) => fs.existsSync(path.join(process.cwd(), 'public', p));
const slotsArtReady = withSlots.every((s) => hasArt(s.art));
---

<section id="journey" class="bg-ink text-white">
  <div class="mx-auto max-w-6xl px-5 py-24 lg:py-32">
    <div class="mx-auto max-w-3xl lg:text-center">
      <h2 class="text-4xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl">
        Everything that stands between seeing an exercise and doing it
      </h2>
    </div>

    <!-- Steps one to three: the same for everyone, and the illustrated part -->
    <ol class="mt-14 grid gap-8 md:grid-cols-3 md:gap-6">
      {
        steps.map((s, i) => (
          <li>
            <div class="grid aspect-[4/3] place-items-center overflow-hidden rounded-2xl bg-white/5 ring-1 ring-white/10">
              <img
                src={s.art}
                alt=""
                width="800"
                height="600"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-contain"
              />
            </div>
            <div class="mt-5 flex gap-3">
              <span class="grid size-[1.875rem] shrink-0 place-items-center rounded-full bg-white/10 text-xs font-bold text-slate-400 ring-1 ring-white/10">
                {i + 1}
              </span>
              <div class="pt-0.5">
                <p class="font-semibold leading-snug text-slate-100">{s.step}</p>
                <p class="mt-1 text-sm leading-relaxed text-slate-400">{s.detail}</p>
              </div>
            </div>
          </li>
        ))
      }
    </ol>

    <!-- Step four: the one that forks -->
    <div class="mt-14">
      <div class="flex gap-3">
        <span class="grid size-[1.875rem] shrink-0 place-items-center rounded-full bg-white/10 text-xs font-bold text-slate-400 ring-1 ring-white/10">
          4
        </span>
        <p class="pt-1 font-semibold leading-snug text-slate-100">
          And it still has to go somewhere.
        </p>
      </div>

      {
        personas.map((persona) => (
          <div
            class={`mt-5 grid gap-5 md:pl-[2.875rem] ${
              persona.journeyBranches.length > 1 ? 'md:grid-cols-2 md:gap-6' : ''
            }`}
            data-when={persona.id}
            hidden={persona.id !== DEFAULT_PERSONA}
          >
            {persona.journeyBranches.map((b) => (
              <div class="rounded-2xl bg-white/5 p-6 ring-1 ring-white/10 sm:p-8">
                <p class="text-[11px] font-bold uppercase tracking-wide text-slate-300">{b.who}</p>
                <p class="mt-2 text-base leading-relaxed text-slate-400">{b.text}</p>
              </div>
            ))}
          </div>
        ))
      }
    </div>

    <!-- The way out -->
    <div class="mt-16 rounded-2xl bg-white p-6 text-ink shadow-xl sm:p-8">
      <p class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-brand-600 lg:justify-center">
        <img src="/app-icon.png" alt="" width="18" height="18" class="size-[18px] rounded-[5px] ring-1 ring-black/5" />
        With Slots
      </p>

      <!-- Cancels steps two, three and four, in their own order. -->
      <p class="mt-3 text-2xl font-bold tracking-tight text-ink sm:text-3xl lg:text-center">
        Nothing to remember. Nothing to find. Nothing to rearrange.
      </p>

      <ol class="mx-auto mt-8 grid max-w-4xl gap-8 md:grid-cols-2">
        {
          withSlots.map((s, i) => (
            <li>
              {slotsArtReady ? (
                <>
                  <div class="grid aspect-[4/3] place-items-center overflow-hidden rounded-2xl bg-slate-50 ring-1 ring-slate-100">
                    <img
                      src={s.art}
                      alt=""
                      width="800"
                      height="600"
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-contain"
                    />
                  </div>
                  <div class="mt-5 flex gap-3">
                    <span class="grid size-[1.875rem] shrink-0 place-items-center rounded-full bg-brand-600 text-xs font-bold text-white">
                      {i + 1}
                    </span>
                    <div class="pt-0.5">
                      <p class="font-semibold leading-snug text-ink">{s.step}</p>
                      <p class="mt-1 text-sm leading-relaxed text-ink-soft">{s.detail}</p>
                    </div>
                  </div>
                </>
              ) : (
                <div class="flex gap-3">
                  <span class="grid size-[1.875rem] shrink-0 place-items-center rounded-full bg-brand-600 text-xs font-bold text-white">
                    {i + 1}
                  </span>
                  <div class="pt-0.5">
                    <p class="font-semibold leading-snug text-ink">{s.step}</p>
                    <p class="mt-1 text-sm leading-relaxed text-ink-soft">{s.detail}</p>
                  </div>
                </div>
              )}
            </li>
          ))
        }
      </ol>

      <div class="mx-auto mt-8 max-w-4xl rounded-xl bg-brand-50 p-5 ring-1 ring-brand-100 lg:text-center">
        <p class="font-bold leading-snug text-ink">
          Slots connects your library to your program.
        </p>
        <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">
          Your saved exercises aren't a list off to the side. They're the
          options inside the week you're already training.
        </p>
      </div>
    </div>
  </div>
</section>
