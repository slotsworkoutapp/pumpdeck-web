---
// The question, directly under the hero: promise first, then who's reading.
// It drives the compare card, the save-to-set chain and the problem pairs.
//
// Nothing is selected until they answer: the question has to feel like it
// decides something. Only THIS section's answer waits on the click — the
// tailored blocks further down the page keep rendering their neutral "a little
// of both" variant, so an unanswered page still reads correctly end to end.
//
// The markup ships with an answer chosen and everything visible, and the script
// clears it on load. That way a visitor with no JS — and a crawler — keeps the
// whole page.
import { personas, DEFAULT_PERSONA } from '../lib/personas';
import Problems from './Problems.astro';
---

<section id="persona" class="scroll-mt-24 bg-slate-50">
  <div class="mx-auto max-w-6xl px-5 py-24 lg:py-32">
    <div class="mx-auto max-w-3xl lg:text-center">
      <h2 class="text-4xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
        How do you usually train?
      </h2>
      <p class="mt-3 text-base text-ink-soft sm:text-lg">
        Pick what sounds most like you.
      </p>
    </div>

    <div
      class="mx-auto mt-8 grid max-w-3xl gap-3 sm:grid-cols-3"
      role="group"
      aria-label="How do you usually train?"
      data-persona-picker
    >
      {
        personas.map((p) => (
          <button
            type="button"
            class="persona-btn relative rounded-2xl bg-white p-5 text-left ring-1 ring-slate-200 transition hover:ring-slate-300"
            data-persona={p.id}
            aria-pressed={p.id === DEFAULT_PERSONA}
          >
            <span class="block font-bold text-ink">{p.label}</span>
            <span class="mt-1 block text-sm leading-relaxed text-ink-soft">{p.detail}</span>
            <span class="persona-stem" aria-hidden="true"></span>
            <span class="persona-cue" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 11v-1a2 2 0 0 0-4 0" />
                  <path d="M14 10V9a2 2 0 0 0-4 0v1" />
                  <path d="M10 9.5V4a2 2 0 0 0-4 0v10" />
                <path d="M18 11a2 2 0 1 1 4 0v3a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-6-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15" />
              </svg>
            </span>
          </button>
        ))
      }
    </div>

    <!-- The answer, in the same blue the chosen card turns. -->
    <div class="mx-auto mt-6 max-w-3xl" data-persona-reveal data-persona-gated>
      {
        personas.map((p) => {
          // Inline flow, not flex items, so the lockup and the headline are one
          // run of text. The nowrap span keeps the icon, wordmark, dash AND the
          // first word together so "Slots —" can't strand on its own line.
          const [firstWord, ...rest] = p.headline.split(' ');
          return (
            <div
              class="rounded-2xl bg-brand-50 p-6 ring-1 ring-brand-100 sm:p-8 lg:text-center"
              data-when={p.id}
              hidden={p.id !== DEFAULT_PERSONA}
            >
              <h3 class="text-2xl font-bold tracking-tight sm:text-3xl lg:text-4xl">
                <span class="whitespace-nowrap"><img
                    src="/app-icon.png"
                    alt=""
                    width="36"
                    height="36"
                    class="mr-2 inline-block size-7 rounded-[0.55rem] align-[-0.22em] shadow-sm ring-1 ring-black/5 sm:size-8 sm:rounded-[0.6rem] lg:size-9 lg:rounded-[0.65rem]"
                  /><span class="wordmark uppercase text-brand-600">Slots</span> <span class="text-slate-300">&mdash;</span> {firstWord}</span> {rest.join(' ')}
              </h3>
              <p class="mt-3 text-base text-ink-soft sm:text-lg">{p.recognition}</p>
            </div>
          );
        })
      }
    </div>

    <!-- The evidence for that answer -->
    <Problems />
  </div>
</section>

<style>
  .persona-btn[aria-pressed='true'] {
    background: #eff6ff;
    box-shadow: inset 0 0 0 2px #2563eb;
  }
  .persona-btn[aria-pressed='true'] > span:first-child {
    color: #1d4ed8;
  }

  /* Until an answer is given, a hand taps the middle card and the card ripples
     under it. Both stop for good on the first click. */
  .persona-cue {
    position: absolute;
    right: -0.5rem;
    bottom: -0.5rem;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    color: #2563eb;
    background: #ffffff;
    border-radius: 9999px;
    box-shadow: 0 6px 16px rgb(15 23 42 / 0.18);
    animation: pb-tap 2.6s ease-in-out infinite;
  }
  .persona-cue svg {
    width: 1.15rem;
    height: 1.15rem;
  }
  .persona-btn::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 1rem;
    pointer-events: none;
  }
  [data-persona-picker]:not(.is-answered) .persona-btn::after {
    animation: pb-ripple 2.6s ease-out infinite;
  }
  .persona-btn:nth-child(2) .persona-cue,
  [data-persona-picker]:not(.is-answered) .persona-btn:nth-child(2)::after {
    animation-delay: 0.13s;
  }
  .persona-btn:nth-child(3) .persona-cue,
  [data-persona-picker]:not(.is-answered) .persona-btn:nth-child(3)::after {
    animation-delay: 0.26s;
  }
  [data-persona-picker].is-answered .persona-cue {
    display: none;
  }

  @keyframes pb-tap {
    0%, 8%, 26%, 100% { transform: translate(0, 0); }
    16% { transform: translate(-2px, -7px); }
  }
  @keyframes pb-ripple {
    0%, 16% { box-shadow: 0 0 0 0 rgb(37 99 235 / 0.35); }
    55% { box-shadow: 0 0 0 12px rgb(37 99 235 / 0); }
    100% { box-shadow: 0 0 0 0 rgb(37 99 235 / 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .persona-cue { animation: none; }
    [data-persona-picker] .persona-btn::after { animation: none; }
  }

  /* Drops out of the chosen card into the answer panel below it. Hidden on
     mobile, where the cards stack and this would point at another button. */
  .persona-stem {
    display: none;
    position: absolute;
    top: 100%;
    left: 50%;
    width: 2px;
    height: 1.5rem;
    background: #bfdbfe;
    transform: translateX(-50%);
  }
  @media (min-width: 640px) {
    .persona-btn[aria-pressed='true'] .persona-stem {
      display: block;
    }
  }

  /* Answering replays the entrance, so a switch reads as a fresh answer
     rather than a silent swap underneath you. */
  .is-revealed {
    animation: pr-rise 0.45s ease both;
  }
  .is-revealed > *:not([hidden]) {
    animation: pr-rise 0.5s ease both;
  }
  .is-revealed > *:nth-child(2):not([hidden]) { animation-delay: 0.05s; }
  .is-revealed > *:nth-child(3):not([hidden]) { animation-delay: 0.1s; }
  .is-revealed > *:nth-child(4):not([hidden]) { animation-delay: 0.15s; }
  .is-revealed > *:nth-child(5):not([hidden]) { animation-delay: 0.2s; }
  .is-revealed > *:nth-child(6):not([hidden]) { animation-delay: 0.25s; }

  @keyframes pr-rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .is-revealed,
    .is-revealed > *:not([hidden]) {
      animation: none;
    }
  }
</style>

<script>
  const picker = document.querySelector<HTMLElement>('[data-persona-picker]');

  if (picker) {
    const buttons = [...picker.querySelectorAll<HTMLButtonElement>('.persona-btn')];

    // Every persona-specific block on the page, wherever it lives. Each is
    // rendered server-side with the default visible, so this only ever swaps
    // which one is on screen.
    const variants = [...document.querySelectorAll<HTMLElement>('[data-when]')];
    // Containers that should replay their entrance when the answer changes.
    const reveals = [...document.querySelectorAll<HTMLElement>('[data-persona-reveal]')];

    // Waits on an answer, unlike the tailored blocks further down the page.
    const gated = [...document.querySelectorAll<HTMLElement>('[data-persona-gated]')];

    const choose = (id: string, animate: boolean) => {
      picker.classList.add('is-answered');
      for (const b of buttons) {
        b.setAttribute('aria-pressed', String(b.dataset.persona === id));
      }
      for (const el of variants) {
        el.hidden = !(el.dataset.when ?? '').split(' ').includes(id);
      }
      for (const el of gated) {
        el.hidden = false;
      }
      if (!animate) return;
      for (const el of reveals) {
        el.classList.remove('is-revealed');
        void el.offsetWidth;
        el.classList.add('is-revealed');
      }
    };

    // Clear the shipped default so the question is genuinely unanswered.
    for (const b of buttons) b.setAttribute('aria-pressed', 'false');
    for (const el of gated) el.hidden = true;

    for (const b of buttons) {
      b.addEventListener('click', () => choose(b.dataset.persona ?? '', true));
    }
  }
</script>
