---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Exercise on Slots"
  description="Open this exercise in Slots and add it to your library — video and muscles included — with one tap."
>
  <section class="mx-auto flex max-w-md flex-col items-center px-5 py-24 text-center">
    <img
      src="/app-icon.png"
      alt="Slots"
      width="72"
      height="72"
      class="h-[72px] w-[72px] rounded-[1.3rem] shadow-lg ring-1 ring-black/5"
    />

    <h1 class="mt-8 text-3xl font-extrabold tracking-tight sm:text-4xl">
      An exercise shared on <span class="text-flame-500">Slots</span>
    </h1>

    <p class="mt-4 text-lg text-ink-soft">
      Get Slots to view this exercise — video and muscles included — and add
      it to your library with one tap.
    </p>

    <div class="mt-8 flex flex-col items-center gap-4">
      <a
        id="open-app"
        href="#"
        class="hidden items-center rounded-full bg-ink px-7 py-3.5 text-base font-semibold text-white shadow-sm transition hover:opacity-90"
      >
        Open in Slots
      </a>
      <a
        href="/#download"
        class="inline-block transition hover:opacity-85"
        aria-label="Download on the App Store"
      >
        <img
          src="/app-store-badge.svg"
          alt="Download on the App Store"
          width="180"
          height="60"
          class="h-[54px] w-auto"
        />
      </a>
    </div>
  </section>

  <script>
    // Served for any /e/<owner>/<id> (via the Vercel rewrite). On an iPhone with
    // the app installed the Universal Link opens the app directly and this page
    // never shows — so it's the fallback for everyone else.
    const parts = location.pathname.split('/').filter(Boolean); // ["e", owner, id]
    if (parts[0] === 'e' && parts[1] && parts[2]) {
      const open = document.getElementById('open-app');
      if (open) {
        open.setAttribute(
          'href',
          'pumpdeck://e/' + encodeURIComponent(parts[1]) + '/' + encodeURIComponent(parts[2]),
        );
        open.classList.remove('hidden');
        open.classList.add('inline-flex');
      }
    }
  </script>
</Layout>
