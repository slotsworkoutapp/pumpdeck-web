---
import Layout from '../layouts/Layout.astro';

// Change to your real contact + an absolute "last updated" date before
// publishing. This template is a starting point — have it reviewed to make
// sure it reflects exactly what PumpDeck collects.
const contactEmail = 'support@pumpdeck.app';
const lastUpdated = 'June 10, 2026';
---

<Layout
  title="Privacy Policy — PumpDeck"
  description="How PumpDeck handles your data."
>
  <article class="mx-auto max-w-3xl px-5 py-16">
    <p class="text-sm font-semibold text-brand-600">Legal</p>
    <h1 class="mt-2 text-4xl font-extrabold tracking-tight">Privacy Policy</h1>
    <p class="mt-3 text-ink-soft">Last updated: {lastUpdated}</p>

    <div
      class="mt-10 space-y-8 text-ink-soft [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:text-ink [&_a]:text-brand-600 [&_a]:underline"
    >
      <section class="space-y-3">
        <p>
          PumpDeck ("we", "us") respects your privacy. This policy explains what
          information the PumpDeck app collects, how we use it, and the choices
          you have.
        </p>
      </section>

      <section class="space-y-3">
        <h2>Information we collect</h2>
        <ul class="list-disc space-y-2 pl-5">
          <li>
            <strong class="text-ink">Account information.</strong> When you create
            an account we store an identifier and the email address used to sign
            in, so we can sync your data across your devices.
          </li>
          <li>
            <strong class="text-ink">Training data.</strong> Workouts, programs,
            targets, exercises, and related progress you create in the app.
          </li>
          <li>
            <strong class="text-ink">Profile details.</strong> Optional details
            such as body weight and height that you choose to enter.
          </li>
        </ul>
      </section>

      <section class="space-y-3">
        <h2>How we use your information</h2>
        <p>
          We use your information solely to provide the app's features: storing
          your program and history, syncing them across your devices, and showing
          your progress. We do not sell your personal data.
        </p>
      </section>

      <section class="space-y-3">
        <h2>Storage and processing</h2>
        <p>
          Your data is stored and synced using Supabase, our backend provider, on
          your behalf. Data is transmitted over encrypted connections and access
          is restricted to your account.
        </p>
      </section>

      <section class="space-y-3">
        <h2>Data retention and deletion</h2>
        <p>
          You can delete your account at any time from within the app, which
          removes your account and associated training data from our systems. To
          request deletion or ask a question, email
          <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.
        </p>
      </section>

      <section class="space-y-3">
        <h2>Children's privacy</h2>
        <p>
          PumpDeck is not directed to children under 13, and we do not knowingly
          collect personal information from them.
        </p>
      </section>

      <section class="space-y-3">
        <h2>Changes to this policy</h2>
        <p>
          We may update this policy from time to time. Material changes will be
          reflected by the "last updated" date above.
        </p>
      </section>

      <section class="space-y-3">
        <h2>Contact</h2>
        <p>
          Questions about this policy? Email
          <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.
        </p>
      </section>
    </div>
  </article>
</Layout>
