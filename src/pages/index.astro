---
import Layout from '../layouts/Layout.astro';
import Tour from '../components/Tour.astro';

// Replace with your real App Store URL once the app is live.
const appStoreUrl = '#';

const faqs = [
  {
    q: 'Briefly, what does this app actually do?',
    a: 'PumpDeck helps you build a weekly program that hits every muscle, fill it with any exercise — even ones you find online — and train toward a custom volume target for each muscle. Rate the pump on every exercise to keep what works best.',
  },
  {
    q: 'What makes PumpDeck different from other fitness apps?',
    a: 'Most apps lock you into their cookie-cutter programs. PumpDeck hands you the controls — build a split that covers every muscle, set custom volume per muscle, add any exercise (even from your feed), and fine-tune it all in a powerful editor — without making it complicated.',
  },
  {
    q: 'Do I have to build my own program?',
    a: 'No. Answer a few questions and PumpDeck builds your whole split and sets a target for every muscle — or set up every detail yourself. Either way, you can tweak anything later.',
  },
  {
    q: 'Can I add exercises I find on social media?',
    a: 'Yes. Save any move you see on TikTok, Instagram, or YouTube as a custom exercise with photos and muscle tags, then drop it straight into your program.',
  },
  {
    q: 'What does “rating the pump” do?',
    a: 'After each exercise you rate the pump from 1 to 10. Over time you can sort your exercises by pump to keep the ones that work best for you.',
  },
  {
    q: 'Can I use PumpDeck for bulking and cutting?',
    a: "Yes. Your training is the one constant through a bulk or a cut, and that's exactly what PumpDeck is built for. Follow your program and hit your targets — then adjust your diet to whichever goal you're on.",
  },
  {
    q: 'Is this app suitable for beginners?',
    a: 'Definitely. Let PumpDeck build your whole program to start, then the muscle maps and targets make it clear exactly what to train each day. Learn and adjust as you go.',
  },
  {
    q: 'Do I need a gym to use this app?',
    a: 'PumpDeck is built mainly for training in a gym, so most exercises assume gym equipment. That said, you can add any exercise and customize your whole program — so you can build a home or bodyweight setup around what you have.',
  },
  {
    q: 'Can I cancel anytime?',
    a: 'Yes. You can manage or cancel a subscription anytime from your App Store account settings, and you keep access until the end of your current billing period.',
  },
];

// Where people find exercises, before they land in PumpDeck.
const socials = [
