---
import Layout from '../layouts/Layout.astro';
import Tour from '../components/Tour.astro';
import SwipeHero from '../components/SwipeHero.astro';

// Replace with your real App Store URL once the app is live.
const appStoreUrl = '#';

const faqs = [
  {
    q: 'Briefly, what does this app actually do?',
    a: "PumpDeck lets you build a weekly program around variations and muscles instead of fixed exercises. Add a whole movement (like “Chest Press”) or a whole muscle to a slot, then pick the exact exercise when you train.",
  },
  {
    q: 'What makes PumpDeck different from other fitness apps?',
    a: 'Most apps lock every day into fixed exercises. PumpDeck lets you add a whole variation (every version of a movement) or a whole muscle to your program, then pick the exact exercise when you train — so you can grab a free machine, try something new, or beat boredom without ever rebuilding your week.',
  },
  {
    q: 'What’s a variation, exactly?',
    a: 'A variation is every version of the same movement grouped together — barbell, dumbbell, and machine bench press are all one “Chest Press.” Add the variation to your program and pick whichever version you feel like on the day.',
  },
  {
    q: 'Can I just pick specific exercises instead of variations?',
    a: 'Of course. A slot can be a whole variation, a whole muscle, or one specific exercise — pin your favorite lift and it stays put, or leave it open and choose when you train. It’s your call, slot by slot.',
  },
  {
    q: 'Does the app come with exercises, or do I add them all myself?',
    a: 'PumpDeck ships with 150+ built-in exercises — the most common movements lifters do for each muscle.',
  },
  {
    q: 'Do I have to build my own program?',
    a: 'No. Answer a few questions and PumpDeck builds your whole split — or set up every detail yourself. Either way, you can tweak anything later.',
  },
  {
    q: 'Can I customize reps, sets, rest, and supersets?',
    a: 'Yes. Set reps, weight, and rest for anything, build supersets, reorder your day, and swap or rotate exercises — far more control over your program than most apps give you.',
  },
  {
    q: 'Does PumpDeck track my sets and progress?',
    a: 'Yes. Log every set as you train, and PumpDeck remembers your last weights and reps so you always know what to beat next time.',
  },
  {
    q: 'Can I add exercises I find on social media?',
    a: 'Yes. Save any move you see on TikTok, Instagram, or YouTube as a custom exercise with photos and muscle tags, then drop it straight into your program.',
  },
  {
    q: 'Can I get exercises from other users?',
    a: 'Yes. Follow anyone to swipe through their public exercises, open a profile and tap “Add to library,” or browse the Discover feed of the most-saved exercises across PumpDeck. Anything you add drops into a variation that’s already in your program.',
  },
  {
    q: 'Is my account private, or can I make it public?',
    a: 'Your account is private by default. Switch it to public and other users can find your profile and add the exercises you’ve made public — switch back to private anytime. You always choose which exercises are public; nothing else is ever shared.',
  },
  {
    q: 'Is this app suitable for beginners?',
    a: 'Definitely. Let PumpDeck build your whole program to start, then the muscle maps make it clear exactly what you train each day. Learn and adjust as you go.',
  },
  {
    q: 'Do I need a gym to use this app?',
    a: 'PumpDeck is built mainly for training in a gym, so most exercises assume gym equipment. That said, you can add any exercise and customize your whole program — so you can build a home or bodyweight setup around what you have.',
  },
  {
    q: 'Can I cancel anytime?',
    a: 'Yes. You can manage or cancel a subscription anytime from your App Store account settings, and you keep access until the end of your current billing period.',
  },
];
---

<Layout>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div
      class="relative mx-auto flex max-w-3xl flex-col items-center px-5 py-20 text-center lg:py-24"
    >
      <h1
        class="text-[2.75rem] font-extrabold leading-[0.98] tracking-tight text-ink sm:text-[4rem] lg:text-[5rem]"
      >
        Finally do the<br />exercises you save
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-soft">
        You save them on TikTok, Instagram, and YouTube — then never do them.
        <span class="font-semibold text-brand-600">One swipe</span>, and an
        exercise you want to try is in your program — skip the saved folder
        you'll never open again.
      </p>

      <div id="download" class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          href={appStoreUrl}
          class="inline-block transition hover:opacity-85"
          aria-label="Download on the App Store"
        >
          <img
            src="/app-store-badge.svg"
            alt="Download on the App Store"
            width="180"
            height="60"
            class="h-[54px] w-auto"
          />
        </a>
      </div>

      <!-- Swipe-to-add discover deck -->
      <div class="mt-10">
        <SwipeHero />
      </div>

    </div>
  </section>

  <!-- Product tour -->
  <Tour />

  <!-- FAQ -->
  <section id="faq" class="bg-slate-50">
    <div class="mx-auto max-w-3xl px-5 py-20">
    <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
      Frequently asked questions
    </h2>
    <div class="mt-8 divide-y divide-slate-200 border-y border-slate-200">
      {
        faqs.map((f) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-semibold text-ink marker:hidden">
              {f.q}
              <svg
                viewBox="0 0 24 24"
                class="size-5 shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <p class="pb-5 -mt-1 leading-relaxed text-ink-soft">{f.a}</p>
          </details>
        ))
      }
    </div>
    <p class="mt-8 text-ink-soft">
      Still have a question?{' '}
      <a
        href="mailto:support@pumpdeck.app"
        class="font-semibold text-brand-600 hover:underline"
      >
        Email us
      </a>
      .
    </p>
    </div>
  </section>

  <!-- Closing call to action -->
  <section class="mx-auto max-w-6xl px-5 pt-20 pb-24 text-center">
    <img
      src="/app-icon.png"
      alt=""
      width="64"
      height="64"
      class="mx-auto size-16 rounded-[1.15rem] shadow-lg ring-1 ring-black/5"
    />
    <h2 class="mx-auto mt-6 max-w-xl text-3xl font-bold tracking-tight sm:text-4xl">
      Finally do the exercises you save
    </h2>
    <p class="mx-auto mt-3 max-w-md text-lg text-ink-soft">
      Your split, your variations, your saves — in a program you'll actually
      follow.
    </p>
    <div class="mt-8 flex justify-center">
      <a
        href={appStoreUrl}
        class="inline-flex items-center rounded-full bg-ink px-7 py-3.5 text-base font-semibold text-white shadow-sm transition hover:opacity-90"
      >
        Try for free
      </a>
    </div>
  </section>
</Layout>
