---
import Layout from '../layouts/Layout.astro';
import PersonaPicker from '../components/PersonaPicker.astro';
import Compare from '../components/Compare.astro';
import SaveJourney from '../components/SaveJourney.astro';
import Tour from '../components/Tour.astro';
import HeroCollage from '../components/HeroCollage.astro';
import { appStoreUrl, socials } from '../lib/site';

const instagram = socials.find((s) => s.name === 'Instagram')?.url;

const faqs = [
  {
    q: 'Briefly, what does this app actually do?',
    a: 'Slots lets you build a weekly program around muscles instead of fixed exercises. Add a muscle to a slot, then pick the exact exercise when you train — or pin one exact exercise if you’d rather.',
  },
  {
    q: 'What makes Slots different from other fitness apps?',
    a: 'Most apps lock every day into fixed exercises. Slots holds the muscle instead, and you pick the exact exercise when you train. So you can grab a free machine, try something new, or beat boredom without ever rebuilding your week.',
  },
  {
    q: 'What does it mean to build around a muscle?',
    a: 'Instead of pinning an exact exercise, you add a muscle — like Chest or Triceps — to a slot. When you train, you pick any exercise that hits it: grab whatever machine’s open, try something new, or repeat a favorite. Your program covers the muscle; the exact exercise is up to you that day.',
  },
  {
    q: 'Can I just pin a specific exercise?',
    a: 'Of course. A slot can hold a muscle or one exact exercise — pin your favorite lift and it stays put, or leave it open and choose when you train. It’s your call, slot by slot.',
  },
  {
    q: 'Does the app come with exercises, or do I add them all myself?',
    a: 'Slots ships with nearly 200 built-in exercises — the most common movements lifters do for each muscle. You can edit any of them, put your own video on one, or build your own from scratch.',
  },
  {
    q: 'Do I have to build my own program?',
    a: 'No. Answer a few questions and Slots builds your whole split — or set up every detail yourself. Either way, you can tweak anything later.',
  },
  {
    q: 'Does Slots track my sets and progress?',
    a: 'Yes. Log every set as you train, and Slots remembers your last weights and reps so you always know what to beat next time.',
  },
  {
    q: 'Is my account public, or can I make it private?',
    a: 'Your account is public by default, so others can find your profile and add the exercises you’ve shared. Switch to private anytime and you disappear from search and feeds — nobody can find or follow you. You always choose which exercises are public; nothing else is ever shared.',
  },
  {
    q: 'Do I need a gym to use this app?',
    a: 'Slots is built mainly for training in a gym, so most exercises assume gym equipment. That said, you can add any exercise and customize your whole program — so you can build a home or bodyweight setup around what you have.',
  },
  {
    q: 'Can I cancel anytime?',
    a: 'Yes. You can manage or cancel a subscription anytime from your App Store account settings, and you keep access until the end of your current billing period.',
  },
];

// The 8 muscle groups and the individual muscles each breaks into — drives the
// muscle library section. Mirrors the app's built-in catalog; maps live in
// /public/maps. Keep in step with content-snapshot.json when muscles are added.
const muscleGroups = [
  { slug: 'chest', name: 'Chest', muscles: ['Upper Chest', 'Mid Chest', 'Lower Chest'] },
  { slug: 'back', name: 'Back', muscles: ['Lats', 'Upper Back', 'Traps', 'Lower Back'] },
  { slug: 'shoulders', name: 'Shoulders', muscles: ['Front Delt', 'Side Delt', 'Rear Delt'] },
  { slug: 'legs', name: 'Legs', muscles: ['Quadriceps', 'Hamstrings', 'Glutes', 'Hip Flexors', 'Abductors', 'Adductors', 'Calves', 'Shins'] },
  { slug: 'core', name: 'Core', muscles: ['Upper Abs', 'Lower Abs', 'Obliques'] },
  { slug: 'biceps', name: 'Biceps', muscles: ['Long Head', 'Short Head'] },
  { slug: 'triceps', name: 'Triceps', muscles: ['Lateral Head', 'Long Head', 'Medial Head'] },
  { slug: 'forearms', name: 'Forearms', muscles: ['Brachioradialis', 'Extensors', 'Flexors'] },
];
const muscleCount = muscleGroups.reduce((n, g) => n + g.muscles.length, 0);
---

<Layout>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden">
    <HeroCollage />
    <div
      class="relative mx-auto flex min-h-[34rem] max-w-3xl flex-col items-center justify-center px-5 py-24 text-center"
      style="min-height: calc(100svh - 4.5rem)"
    >
      <h1
        class="text-[3.1rem] font-bold leading-[1.03] tracking-tight text-ink sm:text-[4rem] sm:leading-[0.98] lg:text-[5rem]"
      >
        Finally do the<br />exercises you save
      </h1>

      <p class="mt-6 max-w-xl text-base leading-relaxed text-ink-soft sm:text-lg">
        You save them on TikTok, Instagram, and YouTube — then they die in a
        folder you never open. With Slots,
        <span class="font-semibold text-brand-600">one swipe</span> and an
        exercise you want to try is in your program.
      </p>

      <div id="download" class="mt-8 flex scroll-mt-24 flex-col items-center gap-3">
        {
          appStoreUrl ? (
            <a
              href={appStoreUrl}
              class="inline-block transition hover:opacity-85"
              aria-label="Download on the App Store"
            >
              <img
                src="/app-store-badge.svg"
                alt="Download on the App Store"
                width="180"
                height="60"
                class="h-[54px] w-auto"
              />
            </a>
          ) : (
            <>
              <span class="inline-flex items-center rounded-full bg-ink px-7 py-3.5 text-base font-semibold text-white shadow-sm">
                Coming soon to the App Store
              </span>
            </>
          )
        }
      </div>

    </div>
  </section>

  <!-- The big idea first: the question below leans on knowing what a slot is -->
  <Compare />

  <!-- Product tour: build → add → train -->
  <Tour />

  <!-- Who's reading. Everything below tunes to the answer. -->
  <PersonaPicker />

  <!-- Why that matters for the exercises you save: the whole save-to-set gauntlet -->
  <SaveJourney />

  <!-- Muscle library — how specific you can get with muscle slots -->
  <section class="mx-auto max-w-6xl px-5 py-24 lg:py-32">
    <div class="max-w-2xl lg:mx-auto lg:text-center">
      <h2 class="text-4xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
        Get as specific as you want — down to {muscleCount} muscles
      </h2>
      <p class="mt-4 text-base text-ink-soft sm:text-lg">
        Keep a slot broad — a whole group like Chest — or get specific with
        Upper, Mid, or Lower Chest. All {muscleCount} are built in, and you can
        add your own.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-2 items-start gap-4 sm:grid-cols-4">
      {
        muscleGroups.map((g) => (
          <details class="group/m rounded-2xl bg-slate-50 ring-1 ring-slate-100 transition-colors open:ring-brand-200 hover:bg-slate-100/70">
            <summary class="flex cursor-pointer list-none flex-col items-center gap-2 p-5 marker:hidden [&::-webkit-details-marker]:hidden">
              <img src={`/maps/${g.slug}.svg`} alt={g.name} class="h-20 w-auto" />
              <p class="font-bold">{g.name}</p>
              <p class="flex items-center gap-1 text-sm font-semibold text-ink-soft">
                {g.muscles.length} muscles
                <svg
                  viewBox="0 0 24 24"
                  class="size-4 text-slate-400 transition-transform duration-200 group-open/m:rotate-180"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.4"
                >
                  <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </p>
            </summary>
            <ul class="space-y-1.5 px-5 pb-5 text-center text-sm font-medium text-ink-soft">
              {g.muscles.map((m) => (
                <li>{m}</li>
              ))}
            </ul>
          </details>
        ))
      }
    </div>

    <p class="mx-auto mt-8 max-w-2xl text-center text-sm text-ink-soft">
      Plus collections — Mobility, Plyometrics, Conditioning, Cardio and Power —
      for the work no single muscle describes. They take a slot just like a
      muscle does.
    </p>
  </section>

  <!-- FAQ -->
  <section id="faq" class="bg-slate-50">
    <div class="mx-auto max-w-3xl px-5 py-24 lg:py-32">
    <h2 class="text-4xl font-bold tracking-tight sm:text-4xl">
      Frequently asked questions
    </h2>
    <div class="mt-8 divide-y divide-slate-200 border-y border-slate-200">
      {
        faqs.map((f) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-semibold text-ink marker:hidden">
              {f.q}
              <svg
                viewBox="0 0 24 24"
                class="size-5 shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <p class="pb-5 -mt-1 leading-relaxed text-ink-soft">{f.a}</p>
          </details>
        ))
      }
    </div>
    <p class="mt-8 text-ink-soft">
      Still have a question?{' '}
      <a
        href="mailto:support@slotsworkout.app"
        class="font-semibold text-brand-600 hover:underline"
      >
        Email us
      </a>
      .
    </p>
    </div>
  </section>

  <!-- Closing call to action -->
  <section class="mx-auto max-w-6xl px-5 pt-24 pb-32 lg:pt-32 text-center">
    <img
      src="/app-icon.png"
      alt=""
      width="64"
      height="64"
      class="mx-auto size-16 rounded-[1.15rem] shadow-lg ring-1 ring-black/5"
    />
    <h2 class="mx-auto mt-6 max-w-xl text-4xl font-bold tracking-tight sm:text-4xl">
      Finally do the exercises you save
    </h2>
    <p class="mx-auto mt-3 max-w-md text-base text-ink-soft sm:text-lg">
      Your split, your muscles, your saves — in a program you'll actually
      follow.
    </p>
    <div class="mt-8 flex flex-col items-center gap-3">
      {
        appStoreUrl ? (
          <a
            href={appStoreUrl}
            class="inline-flex items-center rounded-full bg-ink px-7 py-3.5 text-base font-semibold text-white shadow-sm transition hover:opacity-90"
          >
            Try for free
          </a>
        ) : (
          <>
            <span class="inline-flex items-center rounded-full bg-ink px-7 py-3.5 text-base font-semibold text-white shadow-sm">
              Coming soon to the App Store
            </span>
            {instagram && (
              <p class="text-sm text-ink-soft">
                Follow{' '}
                <a
                  href={instagram}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-semibold text-brand-600 hover:underline"
                >
                  @slotsworkout.app
                </a>{' '}
                to hear when it lands.
              </p>
            )}
          </>
        )
      }
    </div>
  </section>
</Layout>
