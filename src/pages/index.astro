---

<Layout>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div
      class="relative mx-auto flex max-w-3xl flex-col items-center px-5 py-20 text-center lg:py-24"
    >
      <h1
        class="text-[2.75rem] font-extrabold leading-[0.98] tracking-tight text-ink sm:text-[4rem] lg:text-[5rem]"
      >
        Exercises from<br />your feed to your<br />program
      </h1>

      <!-- Social → PumpDeck, right below the headline -->
      <div class="mt-8 flex items-center justify-center gap-3 sm:gap-5">
        <div class="flex items-center gap-2 sm:gap-2.5">
          {
            socials.map((s) => (
              <span
                class="grid size-10 place-items-center rounded-2xl bg-white shadow-md ring-1 ring-slate-100 sm:size-12"
                style={`color:${s.color}`}
                aria-label={s.name}
              >
                <svg viewBox="0 0 24 24" class="size-5 sm:size-6" fill="currentColor">
                  <path d={s.path} />
                </svg>
              </span>
            ))
          }
        </div>
        <svg
          viewBox="0 0 24 24"
          class="arrow-flow size-7 shrink-0 text-slate-400 sm:size-9"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
        >
          <path d="M4 12h15M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <img
          src="/app-icon.png"
          alt="PumpDeck"
          width="64"
          height="64"
          class="size-14 shrink-0 rounded-[1.15rem] shadow-lg ring-1 ring-black/5 sm:size-16"
        />
      </div>

      <p class="mt-8 max-w-xl text-lg leading-relaxed text-ink-soft">
        Build a personal program from the exercises you love — and the ones
        you've been wanting to try.
      </p>

      <div id="download" class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          href={appStoreUrl}
          class="inline-block transition hover:opacity-85"
          aria-label="Download on the App Store"
        >
          <img
            src="/app-store-badge.svg"
            alt="Download on the App Store"
            width="180"
            height="60"
            class="h-[54px] w-auto"
          />
        </a>
      </div>

      <!-- Phone mockup — a single pre-framed PNG (screenshot already inside a
           real iPhone device frame, transparent background). Drop it at
           public/phone.png. See README for how to make it. -->
      <div class="relative mt-14 w-full max-w-[280px]">
        <img
          src="/phone.png"
          alt="PumpDeck on iPhone"
          class="w-full drop-shadow-2xl"
        />
      </div>
    </div>
  </section>

  <style>
    @keyframes arrowFlow {
      0%,
      100% {
        transform: translateX(0);
      }
      50% {
        transform: translateX(5px);
      }
    }
    .arrow-flow {
      animation: arrowFlow 1.4s ease-in-out infinite;
    }
    @media (prefers-reduced-motion: reduce) {
      .arrow-flow {
        animation: none;
      }
    }
  </style>

  <!-- Product tour -->
  <Tour />

  <!-- FAQ -->
  <section id="faq" class="mx-auto max-w-3xl px-5 py-20">
    <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
      Frequently asked questions
    </h2>
    <div class="mt-8 divide-y divide-slate-200 border-y border-slate-200">
      {
        faqs.map((f) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-semibold text-ink marker:hidden">
              {f.q}
              <svg
                viewBox="0 0 24 24"
                class="size-5 shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <p class="pb-5 -mt-1 leading-relaxed text-ink-soft">{f.a}</p>
          </details>
        ))
      }
    </div>
    <p class="mt-8 text-ink-soft">
      Still have a question?{' '}
      <a
        href="mailto:support@pumpdeck.app"
        class="font-semibold text-brand-600 hover:underline"
      >
        Email us
      </a>
      .
    </p>
  </section>
</Layout>
