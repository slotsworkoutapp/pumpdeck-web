---
import Layout from '../layouts/Layout.astro';

// Inline SVG for each feature icon key. Build-time only — returns a string
// rendered with `set:html`.
function iconFor(key: string): string {
  const icons: Record<string, string> = {
    map: '<path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2Zm0 0v14m6-12v14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>',
    target:
      '<circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="3.5" fill="none" stroke="currentColor" stroke-width="1.8"/>',
    calendar:
      '<rect x="3.5" y="5" width="17" height="15" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M3.5 9.5h17M8 3.5v3M16 3.5v3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>',
    flame:
      '<path d="M12 2c1 3-1 4.5-2.5 6S7 11.5 7 14a5 5 0 0 0 10 0c0-2-1-3.5-2-5-1.2 1-2 .5-2-1 0-2 .5-4-1-6Z" fill="currentColor"/>',
    dumbbell:
      '<path d="M4 9v6M7 7v10M17 7v10M20 9v6M7 12h10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>',
    cloud:
      '<path d="M7.5 18a4 4 0 0 1-.5-7.97A5 5 0 0 1 17 9.5a3.5 3.5 0 0 1-.5 8.5H7.5Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>',
  };
  return `<svg viewBox="0 0 24 24" class="size-6">${icons[key] ?? ''}</svg>`;
}

const features = [
  {
    title: 'Muscle-mapped training',
    body: 'Every exercise shows the muscles it actually works on an anatomical body map — so you can see your coverage at a glance, not guess at it.',
    icon: 'map',
  },
  {
    title: 'Weekly targets',
    body: 'Set a target for each muscle group and PumpDeck tracks your sets toward it all week. Know when a muscle is under- or over-trained.',
    icon: 'target',
  },
  {
    title: 'Programs & splits',
    body: 'Build a recurring weekly program with multiple workout variants per day. Swap, rotate, and reorder exercises in seconds.',
    icon: 'calendar',
  },
  {
    title: 'Streaks & daily minimums',
    body: 'Stay consistent with a daily streak and a minimum you can hit on rest days. Miss-day protection keeps momentum going.',
    icon: 'flame',
  },
  {
    title: 'Exercise library',
    body: 'A rich library with photos, primary and secondary movers, and your own custom exercises — all searchable by muscle.',
    icon: 'dumbbell',
  },
  {
    title: 'Synced across devices',
    body: 'Your program, history, and progress sync securely in the background, so your training is always up to date.',
    icon: 'cloud',
  },
];

const steps = [
  {
    n: '01',
    title: 'Build your program',
    body: 'Pick your split, add exercises to each day, and set weekly targets for the muscles you care about.',
  },
  {
    n: '02',
    title: 'Train and log',
    body: 'Start a workout, log your sets, and watch the body map fill in as you cover each muscle group.',
  },
  {
    n: '03',
    title: 'Stay on target',
    body: 'Hit your weekly targets, keep your streak alive, and adjust as you progress — week after week.',
  },
];

// Replace with your real App Store URL once the app is live.
const appStoreUrl = '#';

const appleMark =
  '<path d="M16.4 12.9c0-2 1.6-3 1.7-3-1-1.3-2.4-1.5-2.9-1.6-1.2-.1-2.4.7-3 .7-.6 0-1.6-.7-2.6-.7-1.3 0-2.6.8-3.2 2-1.4 2.4-.4 6 1 8 .7 1 1.5 2 2.5 2 1 0 1.4-.6 2.6-.6 1.2 0 1.5.6 2.6.6 1.1 0 1.8-1 2.5-2 .5-.7.7-1.1 1-1.9-2.6-1-2.7-3.7-1.7-3.9ZM14.6 6.3c.5-.7.9-1.6.8-2.5-.8 0-1.7.5-2.3 1.2-.5.6-.9 1.5-.8 2.4.9.1 1.7-.4 2.3-1.1Z" fill="currentColor"/>';
---

<Layout>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-x-0 -top-40 mx-auto h-[480px] max-w-5xl rounded-full bg-brand-100/60 blur-3xl"
    >
    </div>
    <div
      class="relative mx-auto grid max-w-6xl items-center gap-12 px-5 py-20 lg:grid-cols-2 lg:py-28"
    >
      <div>
        <span
          class="inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700"
        >
          <span class="size-1.5 rounded-full bg-flame-500"></span>
          Train with intent
        </span>
        <h1
          class="mt-5 text-4xl font-extrabold leading-[1.05] tracking-tight text-ink sm:text-5xl lg:text-6xl"
        >
          Plan smarter.<br />Train harder.
        </h1>
        <p class="mt-5 max-w-md text-lg leading-relaxed text-ink-soft">
          PumpDeck maps every set to the muscles it trains, keeps you on target
          each week, and turns consistency into a streak you'll want to keep.
        </p>

        <div id="download" class="mt-8 flex flex-wrap items-center gap-4">
          <a
            href={appStoreUrl}
            class="inline-flex items-center gap-3 rounded-2xl bg-ink px-5 py-3 text-white shadow-sm transition hover:opacity-90"
          >
            <svg viewBox="0 0 24 24" class="size-7"><Fragment set:html={appleMark} /></svg>
            <span class="text-left leading-tight">
              <span class="block text-[11px] text-white/70">Download on the</span>
              <span class="block text-base font-semibold">App Store</span>
            </span>
          </a>
          <a href="#features" class="text-sm font-semibold text-ink-soft hover:text-ink">
            See what's inside &rarr;
          </a>
        </div>
      </div>

      <!-- Phone mockup placeholder -->
      <div class="relative mx-auto w-full max-w-xs">
        <div
          class="aspect-[9/19] rounded-[2.5rem] border-[10px] border-ink bg-gradient-to-b from-brand-50 to-white p-4 shadow-2xl"
        >
          <div class="flex h-full flex-col items-center justify-center gap-3 text-center">
            <span class="grid size-16 place-items-center rounded-2xl bg-brand-500 text-white">
              <svg viewBox="0 0 24 24" class="size-9" fill="currentColor">
                <path
                  d="M12 2c1 3-1 4.5-2.5 6S7 11.5 7 14a5 5 0 0 0 10 0c0-2-1-3.5-2-5-1.2 1-2 .5-2-1 0-2 .5-4-1-6Z"
                ></path>
              </svg>
            </span>
            <p class="px-4 text-sm font-medium text-ink-soft">
              Drop an app screenshot here
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="mx-auto max-w-6xl px-5 py-20">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
        Everything you need to train with purpose
      </h2>
      <p class="mt-4 text-lg text-ink-soft">
        Not just a set logger. PumpDeck connects what you do to what it builds.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((f) => (
          <div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm transition hover:shadow-md">
            <span class="grid size-11 place-items-center rounded-xl bg-brand-50 text-brand-600">
              <Fragment set:html={iconFor(f.icon)} />
            </span>
            <h3 class="mt-4 text-lg font-semibold">{f.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">{f.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- How it works -->
  <section id="how" class="bg-slate-50">
    <div class="mx-auto max-w-6xl px-5 py-20">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">How it works</h2>
      <div class="mt-12 grid gap-8 md:grid-cols-3">
        {
          steps.map((s) => (
            <div>
              <div class="text-sm font-bold text-flame-500">{s.n}</div>
              <h3 class="mt-2 text-xl font-semibold">{s.title}</h3>
              <p class="mt-2 text-ink-soft">{s.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-6xl px-5 py-20">
    <div
      class="overflow-hidden rounded-3xl bg-ink px-8 py-14 text-center text-white sm:px-16"
    >
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
        Your next session starts here
      </h2>
      <p class="mx-auto mt-4 max-w-md text-white/70">
        Build your program, hit your targets, and keep the streak alive.
      </p>
      <a
        href={appStoreUrl}
        class="mt-8 inline-flex items-center gap-3 rounded-2xl bg-white px-5 py-3 text-ink shadow-sm transition hover:opacity-90"
      >
        <svg viewBox="0 0 24 24" class="size-7"><Fragment set:html={appleMark} /></svg>
        <span class="text-base font-semibold">Download on the App Store</span>
      </a>
    </div>
  </section>
</Layout>
