---
import Layout from '../layouts/Layout.astro';

const contactEmail = 'support@pumpdeck.app';

const faqs = [
  {
    q: 'How do I sync my data to a new device?',
    a: 'Sign in with the same account on your new device. Your program, history, and progress sync automatically in the background.',
  },
  {
    q: 'How do I delete my account?',
    a: 'Open Profile → Manage account → Delete account. This removes your account and associated training data. You can also email us to request deletion.',
  },
  {
    q: 'Is my data backed up?',
    a: 'Your data syncs securely to our backend, so signing in on another device restores it. We recommend staying signed in to keep your data backed up.',
  },
  {
    q: 'I found a bug or have a feature request.',
    a: 'We’d love to hear it. Email us with as much detail as you can — including your device and iOS version — and we’ll take a look.',
  },
];
---

<Layout
  title="Support — PumpDeck"
  description="Get help with PumpDeck."
>
  <section class="mx-auto max-w-3xl px-5 py-16">
    <p class="text-sm font-semibold text-brand-600">Help</p>
    <h1 class="mt-2 text-4xl font-extrabold tracking-tight">Support</h1>
    <p class="mt-4 text-lg text-ink-soft">
      Need a hand? We're happy to help. Email us and we'll get back to you as
      soon as we can.
    </p>

    <a
      href={`mailto:${contactEmail}`}
      class="mt-6 inline-flex items-center gap-2 rounded-full bg-brand-500 px-5 py-3 font-semibold text-white shadow-sm transition hover:bg-brand-600"
    >
      <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8">
        <rect x="3" y="5" width="18" height="14" rx="2"></rect>
        <path d="m3 7 9 6 9-6"></path>
      </svg>
      {contactEmail}
    </a>

    <div class="mt-14">
      <h2 class="text-2xl font-bold tracking-tight">Frequently asked questions</h2>
      <dl class="mt-6 divide-y divide-slate-100 border-y border-slate-100">
        {
          faqs.map((item) => (
            <div class="py-5">
              <dt class="font-semibold text-ink">{item.q}</dt>
              <dd class="mt-2 text-ink-soft">{item.a}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
</Layout>
